# Flowstate self-hosted deployment configuration
# Copy to .env and edit as needed: cp .env.example .env

# --- Postgres (used by the bundled db service) ---
POSTGRES_USER=flowstate
POSTGRES_PASSWORD=flowstate
POSTGRES_DB=flowstate

# --- Server ---
FLOWSTATE_PORT=3710

# --- Runner ---
FLOWSTATE_API_KEY=              # runner API key (generate via TUI setup wizard)
FLOWSTATE_RUNNER_CAPABILITY=standard
FLOWSTATE_AGENT_BACKEND=claude-cli
FLOWSTATE_MAX_CONCURRENT=2
FLOWSTATE_MAX_BUILDS=1

# --- Claude Authentication (pick one) ---
# Option 1: API key (usage-based billing via console.anthropic.com)
ANTHROPIC_API_KEY=
# Option 2: OAuth token from a Claude Pro/Max subscription (via `claude login`)
# FLOWSTATE_ANTHROPIC_AUTH_TOKEN=
