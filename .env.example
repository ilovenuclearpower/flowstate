# =============================================================================
# Flowstate Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your deployment.
#
#   cp .env.example .env
#
# All variables have sensible defaults. Only FLOWSTATE_API_KEY and
# ANTHROPIC_API_KEY are required for a working server + runner setup.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the server listens on (also used for the host-side docker port mapping)
# FLOWSTATE_PORT=3710

# Network interface to bind to (0.0.0.0 = all interfaces)
# FLOWSTATE_BIND=0.0.0.0

# Database backend: "sqlite" (default, zero-config) or "postgres"
# FLOWSTATE_DB_BACKEND=sqlite

# SQLite database path (only used when DB_BACKEND=sqlite)
# Defaults to $XDG_DATA_HOME/flowstate/flowstate.db inside the container.
# FLOWSTATE_SQLITE_PATH=

# Postgres connection URL (only used when DB_BACKEND=postgres)
# FLOWSTATE_DATABASE_URL=postgres://flowstate:password@localhost:5432/flowstate

# -----------------------------------------------------------------------------
# Runner
# -----------------------------------------------------------------------------

# URL of the Flowstate server the runner connects to.
# In docker-compose this is set automatically to http://server:3710.
# FLOWSTATE_SERVER_URL=http://localhost:3710

# API key for runner authentication with the server
FLOWSTATE_API_KEY=

# Runner capability level: "standard" or "gpu"
# FLOWSTATE_RUNNER_CAPABILITY=standard

# Agent backend used for code generation: "claude-cli" or "claude-api"
# FLOWSTATE_AGENT_BACKEND=claude-cli

# Maximum number of concurrent runs the runner will process
# FLOWSTATE_MAX_CONCURRENT=2

# Maximum number of concurrent build-type runs
# FLOWSTATE_MAX_BUILDS=1

# Poll interval in seconds (how often the runner checks for new work)
# FLOWSTATE_POLL_INTERVAL=5

# Anthropic API key (required for claude-api backend; also used by claude-cli)
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Postgres
# -----------------------------------------------------------------------------
# Use these when running Postgres alongside the server (e.g. via an additional
# postgres service in docker-compose or an external managed database).

# POSTGRES_USER=flowstate
# POSTGRES_PASSWORD=
# POSTGRES_DB=flowstate

# -----------------------------------------------------------------------------
# Optional: S3 / Garage Object Store
# -----------------------------------------------------------------------------
# Configure an S3-compatible store for artifact storage.

# FLOWSTATE_S3_ENDPOINT=http://localhost:3900
# FLOWSTATE_S3_BUCKET=flowstate
# FLOWSTATE_S3_ACCESS_KEY=
# FLOWSTATE_S3_SECRET_KEY=
# FLOWSTATE_S3_REGION=garage

# -----------------------------------------------------------------------------
# Optional: RunPod GPU Runners
# -----------------------------------------------------------------------------
# Settings for the RunPod pod manager (auto-scaling GPU runners).

# RUNPOD_API_KEY=
# RUNPOD_GPU_TYPE=NVIDIA RTX A4000
# RUNPOD_TEMPLATE_ID=
# RUNPOD_COST_CAP_HOURLY=2.00
